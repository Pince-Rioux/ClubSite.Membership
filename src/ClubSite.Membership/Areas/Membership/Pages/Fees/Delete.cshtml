@page "{id:int}"
@model ClubSite.Membership.Areas.Membership.Pages.Fees.DeleteModel
@{
    ViewData["Title"] = "Beitragsgruppe löschen";
}

<h1>Beitragsgruppe löschen</h1>

<div class="alert alert-danger">
    <h4 class="alert-heading">Möchten Sie diese Beitragsgruppe wirklich löschen?</h4>
    @if (Model.MemberCount > 0)
    {
        <p><strong>Achtung:</strong> Diese Beitragsgruppe ist <strong>@Model.MemberCount aktiven Mitgliedern</strong> zugewiesen. Sie kann erst gelöscht werden, wenn alle Mitglieder umgebucht wurden.</p>
    }
    else
    {
        <p>Diese Aktion kann nicht rückgängig gemacht werden.</p>
    }
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Fee.Name</dd>

    <dt class="col-sm-3">Betrag</dt>
    <dd class="col-sm-9">@Model.Fee.Amount.ToString("C")</dd>

    <dt class="col-sm-3">Intervall</dt>
    <dd class="col-sm-9">@Model.Fee.Interval</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.Fee.Category</dd>

    <dt class="col-sm-3">Standard</dt>
    <dd class="col-sm-9">@(Model.Fee.IsDefault ? "Ja" : "Nein")</dd>

    <dt class="col-sm-3">Mitglieder</dt>
    <dd class="col-sm-9">@Model.MemberCount aktiv</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Fee.Id" />
    @if (Model.MemberCount == 0)
    {
        <button type="submit" class="btn btn-danger">Löschen</button>
    }
    <a asp-page="Index" class="btn btn-secondary">Abbrechen</a>
</form>