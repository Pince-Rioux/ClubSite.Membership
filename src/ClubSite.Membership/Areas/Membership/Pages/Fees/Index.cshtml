@page
@model ClubSite.Membership.Areas.Membership.Pages.Fees.IndexModel
@{
    ViewData["Title"] = "Beitragsgruppen";
}

<h1>Beitragsgruppen</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p>
    <a asp-page="Create" class="btn btn-success">Neue Beitragsgruppe</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Betrag</th>
            <th>Intervall</th>
            <th>Kategorie</th>
            <th>Standard</th>
            <th>Members</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var fee in Model.Fees)
        {
            <tr>
                <td>@fee.Name</td>
                <td>@fee.Amount.ToString("C")</td>
                <td>@fee.Interval</td>
                <td>@fee.Category</td>
                <td>@(fee.IsDefault ? "Ja" : "Nein")</td>
                <td>@fee.Members.Count</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@fee.Id" class="btn btn-sm btn-warning">Bearbeiten</a>
                    <a asp-page="Delete" asp-route-id="@fee.Id" class="btn btn-sm btn-danger">Löschen</a>
                </td>
            </tr>
        }
    </tbody>
</table>