@page "/Membership/Activate"
@model ClubSite.Membership.Areas.Membership.Pages.ActivateModel
@{
    ViewData["Title"] = "Registrierung abschließen";
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registrierung abschließen</title>
    <link rel="stylesheet" href="~/manager/assets/css/slim.min.css" />
    <style>
        body { background: #f5f5f5; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        .activate-container { width: 100%; max-width: 480px; padding: 2rem; }
        .activate-card { background: #fff; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.1); padding: 2rem; }
        .activate-card h1 { font-size: 1.5rem; margin: 0 0 0.25rem 0; color: #333; }
        .activate-card p.subtitle { color: #666; margin-bottom: 1.5rem; font-size: 0.9rem; }
        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; margin-bottom: 0.25rem; font-weight: 600; color: #444; }
        .form-control { display: block; width: 100%; padding: 0.6rem 0.75rem; font-size: 1rem; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        .form-control:focus { border-color: #0d6efd; outline: none; box-shadow: 0 0 0 3px rgba(13,110,253,0.15); }
        .btn-primary { display: block; width: 100%; padding: 0.7rem; background: #0d6efd; color: #fff; border: none; border-radius: 4px; font-size: 1rem; font-weight: 600; cursor: pointer; }
        .btn-primary:hover { background: #0b5ed7; }
        .error-message { color: #d32f2f; background: #fde8e8; padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem; }
        .success-message { color: #1b8a1b; background: #e8f5e9; padding: 1rem; border-radius: 4px; margin-bottom: 1rem; font-size: 1rem; text-align: center; }
        .readonly-field { background: #f0f0f0; padding: 0.6rem 0.75rem; border: 1px solid #ddd; border-radius: 4px; color: #555; }
        .text-muted { color: #888; font-size: 0.85rem; }
    </style>
</head>
<body>
    <div class="activate-container">
        <div class="activate-card">
            @if (Model.IsInvalid)
            {
                <h1>Link ungültig</h1>
                <div class="error-message">
                    Dieser Bestätigungslink ist ungültig oder abgelaufen.
                </div>
                <p class="text-muted">Bitte wenden Sie sich an den Vorstand, um einen neuen Link zu erhalten.</p>
                <a href="/" class="btn btn-primary" style="display:inline-block;text-align:center;text-decoration:none">Zur Startseite</a>
            }
            else if (Model.IsCompleted)
            {
                <div class="success-message">
                    ✅ Ihr Passwort wurde erfolgreich gesetzt. Sie können sich jetzt anmelden.
                </div>
                <a href="/Membership/Login" class="btn btn-primary" style="display:inline-block;text-align:center;text-decoration:none">Zum Login</a>
            }
            else
            {
                <h1>Registrierung abschließen</h1>
                <p class="subtitle">Setzen Sie Ihr Passwort, um die Registrierung abzuschließen.</p>

                @if (!Model.ModelState.IsValid)
                {
                    <div class="error-message">
                        @string.Join(" ", ModelState.Where(p => p.Value != null)
                            .SelectMany(p => p.Value!.Errors)
                            .Select(e => e.ErrorMessage))
                    </div>
                }

                <form method="post">
                    <input type="hidden" name="token" value="@Model.Token" />

                    <div class="form-group">
                        <label>Vorname</label>
                        <div class="readonly-field">@Model.MemberFirstName</div>
                    </div>
                    <div class="form-group">
                        <label>Nachname</label>
                        <div class="readonly-field">@Model.MemberLastName</div>
                    </div>
                    <div class="form-group">
                        <label>E-Mail</label>
                        <div class="readonly-field">@Model.MemberEmail</div>
                    </div>

                    <p class="text-muted">Diese Daten wurden von der Verwaltung hinterlegt und können nicht geändert werden. Bei Fehlern wenden Sie sich an den Vorstand.</p>

                    <hr />

                    <div class="form-group">
                        <label for="password">Passwort</label>
                        <input id="password" name="password" type="password" class="form-control" placeholder="Mindestens 8 Zeichen" required minlength="8" />
                    </div>
                    <div class="form-group">
                        <label for="confirmPassword">Passwort wiederholen</label>
                        <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" placeholder="Passwort wiederholen" required />
                    </div>
                    <button type="submit" class="btn-primary">Registrierung abschließen</button>
                </form>
            }
        </div>
    </div>
</body>
</html>