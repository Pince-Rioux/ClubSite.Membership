@page "{id:int}"
@model ClubSite.Membership.Areas.Membership.Pages.Departments.DeleteModel
@{
    ViewData["Title"] = "Abteilung löschen";
}

<h1>Abteilung löschen</h1>

<div class="alert alert-danger">
    <h4 class="alert-heading">Möchten Sie diese Abteilung wirklich löschen?</h4>
    @if (Model.MemberCount > 0)
    {
        <p><strong>Achtung:</strong> Diese Abteilung hat <strong>@Model.MemberCount aktive(s) Mitglied(er)</strong>. Sie kann erst gelöscht werden, wenn alle Mitglieder umgebucht wurden.</p>
    }
    else
    {
        <p>Diese Aktion kann nicht rückgängig gemacht werden.</p>
    }
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Department.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(Model.Department.Description ?? "-")</dd>

    <dt class="col-sm-3">Mitglieder</dt>
    <dd class="col-sm-9">@Model.MemberCount aktiv</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Department.Id" />
    @if (Model.MemberCount == 0)
    {
        <button type="submit" class="btn btn-danger">Löschen</button>
    }
    <a asp-page="Index" class="btn btn-secondary">Abbrechen</a>
</form>