@page "{id:int}"
@model ClubSite.Membership.Areas.Membership.Pages.Departments.DeleteModel
@{
    ViewData["Title"] = "Delete Department";
}

<h1>Delete Department</h1>

<div class="alert alert-danger">
    <h4 class="alert-heading">Are you sure you want to delete this department?</h4>
    @if (Model.MemberCount > 0)
    {
        <p><strong>Warning:</strong> This department has <strong>@Model.MemberCount active member(s)</strong> assigned. You cannot delete it until all members are reassigned.</p>
    }
    else
    {
        <p>This action cannot be undone.</p>
    }
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Department.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(Model.Department.Description ?? "-")</dd>

    <dt class="col-sm-3">Members</dt>
    <dd class="col-sm-9">@Model.MemberCount active</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Department.Id" />
    @if (Model.MemberCount == 0)
    {
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
    }
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>