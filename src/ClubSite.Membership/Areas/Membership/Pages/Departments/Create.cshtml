@page
@model ClubSite.Membership.Areas.Membership.Pages.Departments.CreateModel
@{
    ViewData["Title"] = "Create Department";
}

<h1>Create Department</h1>

<form method="post" class="row g-3">
    <div class="col-md-6">
        <label asp-for="Department.Name" class="form-label"></label>
        <input asp-for="Department.Name" class="form-control" />
        <span asp-validation-for="Department.Name" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Department.Description" class="form-label">Description</label>
        <input asp-for="Department.Description" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}