@page "{id:int}"
@model ClubSite.Membership.Areas.Membership.Pages.Members.DeleteModel
@{
    ViewData["Title"] = "Mitglied löschen";
}

<partial name="_MembershipNavPartial" />

<h1>Mitglied löschen</h1>

<div class="alert alert-warning">
    <h4 class="alert-heading">Möchten Sie dieses Mitglied wirklich löschen?</h4>
    <p>Der Status des Mitglieds wird auf »Ehemalig« gesetzt, und es erscheint nicht mehr in aktiven Listen.</p>
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Member?.LastName, @Model.Member?.FirstName</dd>

    <dt class="col-sm-3">E-Mail</dt>
    <dd class="col-sm-9">@Model.Member?.Email</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Member?.Status</dd>

    <dt class="col-sm-3">Abteilung</dt>
    <dd class="col-sm-9">@(Model.Member?.Department?.Name ?? "-")</dd>

    <dt class="col-sm-3">Beigetreten am</dt>
    <dd class="col-sm-9">@(Model.Member != null ? Model.Member.JoinedAt.ToShortDateString() : "")</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Member.Id" />
    <button type="submit" class="btn btn-danger">Löschen</button>
    <a asp-page="Index" class="btn btn-secondary">Abbrechen</a>
</form>