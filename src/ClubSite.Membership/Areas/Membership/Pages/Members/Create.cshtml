@page
@model ClubSite.Membership.Areas.Membership.Pages.Members.CreateModel
@{
    ViewData["Title"] = "Create Member";
}

<partial name="_MembershipNavPartial" />

<h1>Create Member</h1>

<form method="post" class="row g-3">
    @* Main member fields *@
    <div class="col-md-6">
        <label asp-for="Member.FirstName" class="form-label"></label>
        <input asp-for="Member.FirstName" class="form-control" />
        <span asp-validation-for="Member.FirstName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Member.LastName" class="form-label"></label>
        <input asp-for="Member.LastName" class="form-control" />
        <span asp-validation-for="Member.LastName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Member.Email" class="form-label"></label>
        <input asp-for="Member.Email" class="form-control" />
        <span asp-validation-for="Member.Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Member.Phone" class="form-label"></label>
        <input asp-for="Member.Phone" class="form-control" />
        <span asp-validation-for="Member.Phone" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Member.BirthDate" class="form-label"></label>
        <input asp-for="Member.BirthDate" class="form-control" type="date"
               value="@(Model.Member.BirthDate.Year > 1 ? Model.Member.BirthDate.ToString("yyyy-MM-dd") : "")" />
        <span asp-validation-for="Member.BirthDate" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Member.MembershipFeeId" class="form-label">Fee / Category</label>
        <select asp-for="Member.MembershipFeeId" asp-items="Model.FeeOptions" class="form-select">
            <option value="">Select fee...</option>
        </select>
        <span asp-validation-for="Member.MembershipFeeId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Member.DepartmentId" class="form-label"></label>
        <select asp-for="Member.DepartmentId" asp-items="Model.DepartmentOptions" class="form-select">
            <option value="">No department</option>
        </select>
    </div>

    @* Guardian (only for Youth) *@
    <div class="col-md-6" id="guardianSection" style="display:none">
        <label asp-for="Member.GuardianMemberId" class="form-label">Guardian</label>
        <select asp-for="Member.GuardianMemberId" asp-items="Model.GuardianOptions" class="form-select">
            <option value="">Select guardian...</option>
        </select>
        <span asp-validation-for="Member.GuardianMemberId" class="text-danger"></span>
    </div>

    @* Family members section (only for Family) *@
    <div class="col-12" id="familySection" style="display:none">
        <hr />
        <h5>Family Members</h5>
        <p class="text-muted">Add additional family members. The main member above is automatically part of this family.</p>

        <div id="familyMembersContainer">
            @* Template row — hidden, used for cloning *@
            <div id="familyMemberTemplate" class="family-member-row row g-2 mb-2 p-2 border rounded" style="display:none">
                <div class="col-md-2">
                    <input name="FamilyMembers[INDEX].FirstName" class="form-control form-control-sm" placeholder="Vorname" />
                </div>
                <div class="col-md-2">
                    <input name="FamilyMembers[INDEX].LastName" class="form-control form-control-sm" placeholder="Nachname" />
                </div>
                <div class="col-md-2">
                    <input name="FamilyMembers[INDEX].Email" class="form-control form-control-sm" type="email" placeholder="E-Mail" />
                </div>
                <div class="col-md-2">
                    <input name="FamilyMembers[INDEX].BirthDate" class="form-control form-control-sm" type="date" />
                </div>
                <div class="col-md-1">
                    <select name="FamilyMembers[INDEX].Relationship" class="form-select form-select-sm">
                        <option value="">Verhältnis</option>
                        <option value="Ehepartner">Ehepartner</option>
                        <option value="Kind">Kind</option>
                        <option value="Geschwister">Geschwister</option>
                        <option value="Elternteil">Elternteil</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <input name="FamilyMembers[INDEX].JoinedAt" class="form-control form-control-sm" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-1">
                    <span class="text-danger small" style="display:none" data-validation-for="FamilyMembers[INDEX]"></span>
                </div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-family-row" title="Remove">&times;</button>
                </div>
            </div>
        </div>

        <button type="button" class="btn btn-sm btn-outline-primary" id="addFamilyMemberBtn">
            + Add family member
        </button>
        <div id="familyMemberErrors" class="text-danger mt-1"></div>
        <hr />
    </div>

    @* Address fields *@
    <div class="col-md-6">
        <label asp-for="Member.Street" class="form-label"></label>
        <input asp-for="Member.Street" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Member.City" class="form-label"></label>
        <input asp-for="Member.City" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Member.ZipCode" class="form-label"></label>
        <input asp-for="Member.ZipCode" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Member.Country" class="form-label"></label>
        <input asp-for="Member.Country" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Member.Notes" class="form-label"></label>
        <textarea asp-for="Member.Notes" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-md-6">
        <label asp-for="Member.BankIban" class="form-label"></label>
        <input asp-for="Member.BankIban" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Member.BankBic" class="form-label"></label>
        <input asp-for="Member.BankBic" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const feeSelect = document.getElementById('Member_MembershipFeeId');
            const guardianSection = document.getElementById('guardianSection');
            const familySection = document.getElementById('familySection');
            const familyContainer = document.getElementById('familyMembersContainer');
            const template = document.getElementById('familyMemberTemplate');
            const addBtn = document.getElementById('addFamilyMemberBtn');
            let familyMemberIndex = @Model.FamilyMembers.Count;

            // Get fee category data from optgroup labels
            function getSelectedFeeCategory() {
                const selectedOption = feeSelect.options[feeSelect.selectedIndex];
                if (!selectedOption || !selectedOption.parentElement) return null;
                const groupLabel = selectedOption.parentElement.getAttribute('label');
                return groupLabel || null;
            }

            function toggleSections() {
                const category = getSelectedFeeCategory();

                // Guardian: show only for Youth
                if (category === 'Youth') {
                    guardianSection.style.display = 'block';
                } else {
                    guardianSection.style.display = 'none';
                }

                // Family: show only for Family
                if (category === 'Family') {
                    familySection.style.display = 'block';
                } else {
                    familySection.style.display = 'none';
                }
            }

            // Add a new family member row
            function addFamilyMemberRow(data) {
                data = data || {};
                const clone = template.cloneNode(true);
                clone.style.display = 'flex';
                clone.removeAttribute('id');

                const index = familyMemberIndex++;

                // Fix field names
                clone.querySelectorAll('input, select').forEach(field => {
                    const name = field.getAttribute('name');
                    if (name) {
                        field.setAttribute('name', name.replace('INDEX', index));
                        field.setAttribute('id', 'FamilyMembers_' + index + '_' + name.split('.').pop());
                    }
                });

                // Pre-fill if editing
                if (data.firstName) clone.querySelector('[placeholder="Vorname"]').value = data.firstName;
                if (data.lastName) clone.querySelector('[placeholder="Nachname"]').value = data.lastName;
                if (data.email) clone.querySelector('[placeholder="E-Mail"]').value = data.email;
                if (data.birthDate) clone.querySelector('[type="date"]').value = data.birthDate;
                if (data.joinedAt) clone.querySelectorAll('[type="date"]')[1].value = data.joinedAt;
                if (data.relationship) {
                    const relSelect = clone.querySelector('select');
                    relSelect.value = data.relationship;
                }

                // Show validation errors on re-render
                const errorSpan = clone.querySelector('[data-validation-for]');
                if (data.errors && data.errors.length > 0) {
                    errorSpan.style.display = 'inline';
                    errorSpan.textContent = data.errors.join(', ');
                } else if (data.hasErrors) {
                    errorSpan.style.display = 'inline';
                    errorSpan.textContent = 'Bitte prüfen Sie die Eingaben';
                }

                // Remove button
                clone.querySelector('.remove-family-row').addEventListener('click', function () {
                    clone.remove();
                });

                familyContainer.appendChild(clone);
            }

            // Pre-populate existing family members (from server-side validation failures)
            @{
                var validationErrors = ViewData.ModelState
                    .Where(kvp => kvp.Key.StartsWith("FamilyMembers[") && kvp.Value?.Errors.Count > 0)
                    .ToList();
                var memberIndicesWithErrors = validationErrors
                    .Select(kvp => {
                        var match = System.Text.RegularExpressions.Regex.Match(kvp.Key, @"FamilyMembers\[(\d+)\]");
                        return match.Success ? int.Parse(match.Groups[1].Value) : -1;
                    })
                    .Where(i => i >= 0)
                    .Distinct()
                    .ToHashSet();
            }
            @for (int i = 0; i < Model.FamilyMembers.Count; i++)
            {
                var fm = Model.FamilyMembers[i];
                var hasErrors = memberIndicesWithErrors.Contains(i);
                var errors = validationErrors
                    .Where(kvp => kvp.Key.StartsWith($"FamilyMembers[{i}]"))
                    .SelectMany(kvp => kvp.Value!.Errors.Select(e => e.ErrorMessage))
                    .ToList();
                <text>
                addFamilyMemberRow({
                    firstName: '@fm.FirstName.Replace("'", "\\'")',
                    lastName: '@fm.LastName.Replace("'", "\\'")',
                    email: '@fm.Email.Replace("'", "\\'")',
                    birthDate: '@fm.BirthDate.ToString("yyyy-MM-dd")',
                    joinedAt: '@fm.JoinedAt.ToString("yyyy-MM-dd")',
                    relationship: '@fm.Relationship',
                    hasErrors: @(hasErrors ? "true" : "false"),
                    @* Pass errors as a string since we can't serialize List<string> into JS easily *@
                    errors: @(System.Text.Json.JsonSerializer.Serialize(errors))
                });
                </text>
            }

            // Event listeners
            feeSelect.addEventListener('change', toggleSections);
            addBtn.addEventListener('click', function () {
                addFamilyMemberRow({});
            });

            // Initial toggle
            toggleSections();
        });
    </script>
}