@page
@model ClubSite.Membership.Areas.Membership.Pages.Members.IndexModel
@{
    ViewData["Title"] = "Mitglieder";
}

<partial name="_MembershipNavPartial" />

<h1>Mitglieder</h1>

<form method="get" class="row g-3 mb-3">
    <div class="col-md-3">
        <input type="text" name="searchTerm" class="form-control" placeholder="Suchen..." value="@Model.SearchTerm" />
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select" asp-items="Model.StatusOptions">
            <option value="">Alle Status</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="departmentId" class="form-select" asp-items="Model.DepartmentOptions">
            <option value="">Alle Abteilungen</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="feeCategory" class="form-select" asp-items="Model.FeeCategoryOptions">
            <option value="">Alle Beiträge</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">Suchen</button>
    </div>
</form>

<p>
    <a asp-page="Create" class="btn btn-success">Neues Mitglied</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>E-Mail</th>
            <th>Beitragsgruppe</th>
            <th>Status</th>
            <th>Department</th>
            <th>Beigetreten</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model.Members)
        {
            <tr>
                <td>@member.LastName, @member.FirstName</td>
                <td>@member.Email</td>
                <td>@(member.MembershipFee?.Category.ToString() ?? "-")</td>
                <td>@member.Status</td>
                <td>@member.Department?.Name</td>
                <td>@member.JoinedAt.ToShortDateString()</td>
                <td>
                    <a asp-page="Details" asp-route-id="@member.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-page="Edit" asp-route-id="@member.Id" class="btn btn-sm btn-warning">Bearbeiten</a>
                    <a asp-page="Delete" asp-route-id="@member.Id" class="btn btn-sm btn-danger">Löschen</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a asp-page="Index" asp-route-currentpage="@i" asp-route-searchTerm="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-departmentId="@Model.DepartmentIdFilter" asp-route-feeCategory="@Model.FeeCategory" class="page-link">@i</a>
                </li>
            }
        </ul>
    </nav>
}