@page "/Membership/Login"
@model ClubSite.Membership.Areas.Membership.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = null; // clean page, no site chrome
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login – Mitgliederbereich</title>
    <link rel="stylesheet" href="~/manager/assets/css/slim.min.css" />
    <style>
        body {
            background: #f5f5f5;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 2rem;
        }
        .login-card {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.1);
            padding: 2rem;
        }
        .login-card h1 {
            font-size: 1.5rem;
            margin: 0 0 0.25rem 0;
            color: #333;
        }
        .login-card p.subtitle {
            color: #666;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
        }
        .form-group {
            margin-bottom: 1rem;
        }
        .form-group label {
            display: block;
            margin-bottom: 0.25rem;
            font-weight: 600;
            color: #444;
        }
        .form-control {
            display: block;
            width: 100%;
            padding: 0.6rem 0.75rem;
            font-size: 1rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }
        .form-control:focus {
            border-color: #0d6efd;
            outline: none;
            box-shadow: 0 0 0 3px rgba(13,110,253,0.15);
        }
        .btn-primary {
            display: block;
            width: 100%;
            padding: 0.7rem;
            background: #0d6efd;
            color: #fff;
            border: none;
            border-radius: 4px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-primary:hover {
            background: #0b5ed7;
        }
        .error-message {
            color: #d32f2f;
            background: #fde8e8;
            padding: 0.75rem;
            border-radius: 4px;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }
        .text-muted {
            color: #888;
            font-size: 0.85rem;
            text-align: center;
            margin-top: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <h1>Mitgliederbereich</h1>
            <p class="subtitle">Melden Sie sich mit Ihrer E-Mail und Ihrem Passwort an.</p>

            @if (!Model.ModelState.IsValid)
            {
                <div class="error-message">
                    @string.Join(" ", ModelState.Where(p => p.Value != null)
                        .SelectMany(p => p.Value!.Errors)
                        .Select(e => e.ErrorMessage))
                </div>
            }

            <form method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="email">E-Mail</label>
                    <input id="email" name="email" type="email" class="form-control"
                           placeholder="ihre@email.de" required autofocus />
                </div>
                <div class="form-group">
                    <label for="password">Passwort</label>
                    <input id="password" name="password" type="password" class="form-control"
                           placeholder="Passwort" required />
                </div>
                <button type="submit" class="btn-primary">Anmelden</button>
            </form>

            <p class="text-muted">
                <a href="/">Zurück zur Startseite</a>
            </p>
        </div>
    </div>
</body>
</html>