@page "/Membership/Register"
@model VereinMember.Areas.Membership.Pages.RegisterModel
@{
    ViewData["Title"] = "Mitglied werden";
}

<h1>Mitglied werden</h1>
<p class="text-muted">Registrieren Sie sich als Mitglied des Volleyballclub Neusäß e. V.</p>

<form method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="col-12">
        <h5 class="border-bottom pb-2">Persönliche Daten</h5>
    </div>

    <div class="col-md-6">
        <label asp-for="Member.FirstName" class="form-label"></label>
        <input asp-for="Member.FirstName" class="form-control" />
        <span asp-validation-for="Member.FirstName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Member.LastName" class="form-label"></label>
        <input asp-for="Member.LastName" class="form-control" />
        <span asp-validation-for="Member.LastName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Member.Email" class="form-label"></label>
        <input asp-for="Member.Email" class="form-control" type="email" />
        <span asp-validation-for="Member.Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Member.Phone" class="form-label"></label>
        <input asp-for="Member.Phone" class="form-control" type="tel" />
        <span asp-validation-for="Member.Phone" class="text-danger"></span>
    </div>

    @* Password *@
    <div class="col-md-6">
        <label for="Password" class="form-label">Passwort</label>
        <div class="input-group">
            <input id="Password" name="Password" type="password" class="form-control" autocomplete="new-password" />
            <button type="button" class="btn btn-outline-secondary" id="togglePassword" tabindex="-1">&#128065;</button>
        </div>
        <div class="form-text">Mindestens 8 Zeichen. Optional — falls leer, erhalten Sie einen Bestätigungslink per E-Mail.</div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label for="PasswordConfirm" class="form-label">Passwort bestätigen</label>
        <input id="PasswordConfirm" name="PasswordConfirm" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="PasswordConfirm" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label">Geburtsdatum</label>
        <div class="row g-1">
            <div class="col-4">
                <select asp-for="BirthDay" class="form-select">
                    <option value="">Tag</option>
                    @for (int d = 1; d <= 31; d++)
                    {
                        <option value="@d">@d</option>
                    }
                </select>
            </div>
            <div class="col-4">
                <select asp-for="BirthMonth" class="form-select">
                    <option value="">Monat</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </div>
            <div class="col-4">
                <select asp-for="BirthYear" class="form-select">
                    <option value="">Jahr</option>
                    @for (int y = DateTime.Today.Year; y >= 1900; y--)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
        </div>
        <span asp-validation-for="Member.BirthDate" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Member.MembershipFeeId" class="form-label">Beitragsgruppe</label>
        <select asp-for="Member.MembershipFeeId" asp-items="Model.FeeOptions" class="form-select">
            <option value="">Bitte wählen…</option>
        </select>
        <span asp-validation-for="Member.MembershipFeeId" class="text-danger"></span>
    </div>

    @* Guardian section (shown when Youth is selected) *@
    <div class="col-12" id="guardianSection" style="display:none">
        <h5 class="border-bottom pb-2">Erziehungsberechtigter</h5>
        <p class="text-muted">Da Sie unter 18 Jahren sind, benötigen wir die Daten eines Erziehungsberechtigten.</p>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="GuardianFirstName" class="form-label">Vorname</label>
                <input asp-for="GuardianFirstName" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="GuardianLastName" class="form-label">Nachname</label>
                <input asp-for="GuardianLastName" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="GuardianEmail" class="form-label">E-Mail</label>
                <input asp-for="GuardianEmail" class="form-control" type="email" />
            </div>
            <div class="col-md-3">
                <label asp-for="GuardianPhone" class="form-label">Telefon</label>
                <input asp-for="GuardianPhone" class="form-control" type="tel" />
            </div>
        </div>
    </div>

    @* Family section (shown when Family is selected) *@
    <div class="col-12" id="familySection" style="display:none">
        <h5 class="border-bottom pb-2">Familienmitglieder</h5>
        <p class="text-muted">Fügen Sie weitere Familienmitglieder hinzu. Sie sind als Hauptmitglied automatisch Teil dieser Familie.</p>

        <div id="familyMembersContainer">
            <div id="familyMemberTemplate" class="family-member-row row g-2 mb-2 p-2 border rounded" style="display:none">
                <div class="col-md-3">
                    <input name="FamilyMembers[INDEX].FirstName" class="form-control form-control-sm" placeholder="Vorname" />
                </div>
                <div class="col-md-3">
                    <input name="FamilyMembers[INDEX].LastName" class="form-control form-control-sm" placeholder="Nachname" />
                </div>
                <div class="col-md-2">
                    <input name="FamilyMembers[INDEX].Email" class="form-control form-control-sm" type="email" placeholder="E-Mail" />
                </div>
                <div class="col-md-3">
                    <div class="row g-1">
                        <div class="col-4">
                            <select name="FamilyMembers[INDEX].BirthDay" class="form-select form-select-sm">
                                <option value="">Tag</option>
                                @for (int d = 1; d <= 31; d++) { <option value="@d">@d</option> }
                            </select>
                        </div>
                        <div class="col-4">
                            <select name="FamilyMembers[INDEX].BirthMonth" class="form-select form-select-sm">
                                <option value="">Monat</option>
                                @for (int m = 1; m <= 12; m++) { <option value="@m">@m</option> }
                            </select>
                        </div>
                        <div class="col-4">
                            <select name="FamilyMembers[INDEX].BirthYear" class="form-select form-select-sm">
                                <option value="">Jahr</option>
                                @for (int y = DateTime.Today.Year; y >= 1900; y--) { <option value="@y">@y</option> }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-family-row" title="Entfernen">&times;</button>
                </div>
            </div>
        </div>

        <button type="button" class="btn btn-sm btn-outline-primary" id="addFamilyMemberBtn">
            + Familienmitglied hinzufügen
        </button>
        <hr />
    </div>

    <div class="col-12">
        <h5 class="border-bottom pb-2">Adresse</h5>
    </div>

    <div class="col-md-6">
        <label asp-for="Member.Street" class="form-label"></label>
        <input asp-for="Member.Street" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Member.ZipCode" class="form-label"></label>
        <input asp-for="Member.ZipCode" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Member.City" class="form-label"></label>
        <input asp-for="Member.City" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Member.Country" class="form-label"></label>
        <input asp-for="Member.Country" class="form-control" />
    </div>

    @* Zahlungsinformationen *@
    <div class="col-12 mt-3">
        <h5 class="border-bottom pb-2">Zahlungsinformationen (optional)</h5>
    </div>
    <div class="col-md-6">
        <label asp-for="Member.BankIban" class="form-label">IBAN</label>
        <input asp-for="Member.BankIban" class="form-control" placeholder="DE00 0000 0000 0000 0000 00" />
        <span asp-validation-for="Member.BankIban" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Member.BankBic" class="form-label">BIC</label>
        <input asp-for="Member.BankBic" class="form-control" />
        <span asp-validation-for="Member.BankBic" class="text-danger"></span>
    </div>

    @* Datenschutz *@
    <div class="col-12 mt-3">
        <div class="form-check">
            <input id="PrivacyConsented" name="PrivacyConsented" type="checkbox" class="form-check-input" value="true" />
            <label class="form-check-label" for="PrivacyConsented">
                Ich habe die <a href="/datenschutz" target="_blank">Datenschutzerklärung</a> zur Kenntnis genommen und stimme zu.
            </label>
            <span asp-validation-for="PrivacyConsented" class="text-danger"></span>
        </div>
    </div>

    <div class="col-12 mt-4">
        <button type="submit" class="btn btn-primary btn-lg">Registrieren</button>
        <a href="/" class="btn btn-outline-secondary btn-lg">Abbrechen</a>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const feeSelect = document.getElementById('Member_MembershipFeeId');
            const guardianSection = document.getElementById('guardianSection');
            const familySection = document.getElementById('familySection');
            const familyContainer = document.getElementById('familyMembersContainer');
            const template = document.getElementById('familyMemberTemplate');
            const addBtn = document.getElementById('addFamilyMemberBtn');
            let familyMemberIndex = 0;

            // Passwort show/hide toggle
            const pwInput = document.getElementById('Password');
            const pwToggle = document.getElementById('togglePassword');
            if (pwToggle && pwInput) {
                pwToggle.addEventListener('click', function () {
                    const type = pwInput.getAttribute('type');
                    pwInput.setAttribute('type', type === 'password' ? 'text' : 'password');
                });
            }

            function getSelectedFeeCategory() {
                const selectedOption = feeSelect.options[feeSelect.selectedIndex];
                if (!selectedOption || !selectedOption.parentElement) return null;
                return selectedOption.parentElement.getAttribute('label') || null;
            }

            function toggleSections() {
                const category = getSelectedFeeCategory();
                guardianSection.style.display = (category === '1') ? 'block' : 'none';
                familySection.style.display = (category === '2') ? 'block' : 'none';
            }

            function addFamilyMemberRow() {
                const clone = template.cloneNode(true);
                clone.style.display = 'flex';
                clone.removeAttribute('id');

                const index = familyMemberIndex++;
                clone.querySelectorAll('input, select').forEach(el => {
                    const name = el.getAttribute('name');
                    if (name) {
                        el.setAttribute('name', name.replace('INDEX', index));
                    }
                });

                clone.querySelector('.remove-family-row').addEventListener('click', function () {
                    clone.remove();
                });

                familyContainer.appendChild(clone);
            }

            feeSelect.addEventListener('change', toggleSections);
            addBtn.addEventListener('click', addFamilyMemberRow);
            toggleSections();
        });
    </script>
}