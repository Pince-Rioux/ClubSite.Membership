@page "/Membership/Login"
@model VereinMember.Areas.Membership.Pages.LoginModel
@{
    ViewData["Title"] = "Anmelden – Mitgliederbereich";
}

<h1>Anmelden</h1>
<p class="text-muted">Melden Sie sich mit Ihrer E-Mail und Ihrem Passwort an.</p>

@if (!Model.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @string.Join(" ", ModelState.Where(p => p.Value != null)
            .SelectMany(p => p.Value!.Errors)
            .Select(e => e.ErrorMessage))
    </div>
}

<form method="post" class="row g-3">
    <div class="col-12">
        <label for="email" class="form-label">E-Mail</label>
        <input id="email" name="email" type="email" class="form-control" required autofocus />
    </div>
    <div class="col-12">
        <label for="password" class="form-label">Passwort</label>
        <input id="password" name="password" type="password" class="form-control" required />
    </div>
    <div class="col-12 mt-3">
        <button type="submit" class="btn btn-primary">Anmelden</button>
    </div>
</form>

<p class="mt-3">
    <a href="/">Zurück zur Startseite</a>
</p>