@page "/Membership/RegisterConfirmation"
@model VereinMember.Areas.Membership.Pages.RegisterConfirmationModel
@{
    ViewData["Title"] = "Registrierung bestätigt";
}

<div class="text-center py-5">
    <h1>📧 Fast geschafft!</h1>
    <p class="lead">Ihre Registrierung wurde erfolgreich übernommen.</p>
    <p>Bitte prüfen Sie Ihr E-Mail-Postfach (<strong>@Model.Email</strong>) und klicken Sie auf den Bestätigungslink, um Ihr Passwort zu setzen und die Registrierung abzuschließen.</p>
    <p class="text-muted">Der Link ist 7 Tage gültig.</p>
    <a href="/" class="btn btn-primary mt-3">Zurück zur Startseite</a>
</div>