@page
@model VereinMember.Areas.Membership.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Abteilungen";
}

<h1>Abteilungen</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p>
    <a asp-page="Create" class="btn btn-success">Neue Abteilung</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Members</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var department in Model.Departments)
        {
            <tr>
                <td>@department.Name</td>
                <td>@(department.Description ?? "-")</td>
                <td>@department.Members.Count</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@department.Id" class="btn btn-sm btn-warning">Bearbeiten</a>
                    <a asp-page="Delete" asp-route-id="@department.Id" class="btn btn-sm btn-danger">Löschen</a>
                </td>
            </tr>
        }
    </tbody>
</table>