@page "{id:int}"
@model VereinMember.Areas.Membership.Pages.Members.DetailsModel
@{
    ViewData["Title"] = "Mitglied-Details";
}

<partial name="_MembershipNavPartial" />

<h1>Mitglied-Details</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Member?.LastName, @Model.Member?.FirstName</dd>

    <dt class="col-sm-3">E-Mail</dt>
    <dd class="col-sm-9">@Model.Member?.Email</dd>

    <dt class="col-sm-3">Telefon</dt>
    <dd class="col-sm-9">@(Model.Member?.Phone ?? "-")</dd>

    <dt class="col-sm-3">Geburtsdatum</dt>
    <dd class="col-sm-9">@Model.Member?.BirthDate.ToShortDateString()</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Member?.Status</dd>

    <dt class="col-sm-3">Abteilung</dt>
    <dd class="col-sm-9">@(Model.Member?.Department?.Name ?? "-")</dd>

    <dt class="col-sm-3">Beitragsgruppe</dt>
    <dd class="col-sm-9">@(Model.Member?.MembershipFee?.Name ?? "-")</dd>

    @if (Model.Member?.GuardianMember != null)
    {
        <dt class="col-sm-3">Erziehungsberechtigter</dt>
        <dd class="col-sm-9">@Model.Member.GuardianMember.LastName, @Model.Member.GuardianMember.FirstName</dd>
    }

    @if (Model.Member?.FamilyGroup != null)
    {
        <dt class="col-sm-3">Familie</dt>
        <dd class="col-sm-9">@(Model.Member.FamilyGroup.Name ?? "Family #" + @Model.Member.FamilyGroup.Id)</dd>
    }

    <dt class="col-sm-3">Adresse</dt>
    <dd class="col-sm-9">@Model.Member?.Street, @Model.Member?.ZipCode @Model.Member?.City, @Model.Member?.Country</dd>

    <dt class="col-sm-3">Beigetreten am</dt>
    <dd class="col-sm-9">@Model.Member?.JoinedAt.ToShortDateString()</dd>

    @if (Model.Member?.LeftAt.HasValue == true)
    {
        <dt class="col-sm-3">Ausgetreten am</dt>
        <dd class="col-sm-9">@Model.Member?.LeftAt.Value.ToShortDateString()</dd>
    }

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@(Model.Member?.Notes ?? "-")</dd>

    <dt class="col-sm-3">Erstellt</dt>
    <dd class="col-sm-9">@Model.Member?.CreatedAt.ToShortDateString() by @Model.Member?.CreatedBy</dd>

    <dt class="col-sm-3">Aktualisiert</dt>
    <dd class="col-sm-9">@Model.Member?.UpdatedAt.ToShortDateString()</dd>
</dl>

<div>
    <a asp-page="Edit" asp-route-id="@Model.Member?.Id" class="btn btn-warning">Bearbeiten</a>
    <a asp-page="Index" class="btn btn-secondary">Zurück zur Liste</a>
</div>