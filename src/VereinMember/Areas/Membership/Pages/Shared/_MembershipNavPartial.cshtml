@using Microsoft.AspNetCore.Identity
@using VereinMember.Models
@inject SignInManager<MembershipUser> SignInManager
@inject UserManager<MembershipUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light border rounded">
        <div>
            <span class="text-muted small">Angemeldet als</span>
            <strong class="ms-1">@user?.UserName ?? user?.Email</strong>
        </div>
        <div>
            <a asp-page="/Members/Index" class="btn btn-sm btn-outline-secondary me-1">Mitglieder</a>
            <a asp-page="/Profile" class="btn btn-sm btn-outline-primary me-1">Profil</a>
            <a asp-page="/Logout" class="btn btn-sm btn-outline-danger">Abmelden</a>
        </div>
    </div>
}