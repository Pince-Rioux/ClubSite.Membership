@{
    // Use the host's ClubSite layout for consistent chrome.
    // Note: partials in the host layout (like _MenuTopLevel) need app-relative paths
    // because view discovery from the Membership area doesn't find them otherwise.
    Layout = "/Pages/_Layout.cshtml";
}

@*
    Load ClubSite assets as fallback in case the layout resolution context
    from the RCL doesn't pick them up (Area views sometimes lose asset links).
*@
@section head {
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/fonts/fonts-lato-raleway.css">
    <link rel="stylesheet" href="~/assets/css/style.min.css" asp-append-version="true">
    <link href="~/assets/css/fontawesome/fontawesome.min.css" asp-append-version="true" rel="stylesheet">
}