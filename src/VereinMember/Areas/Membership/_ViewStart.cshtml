@{
    // Use the host's ClubSite layout for consistent chrome.
    // Note: partials in the host layout (like _MenuTopLevel) need app-relative paths
    // because view discovery from the Membership area doesn't find them otherwise.
    Layout = "/Pages/_Layout.cshtml";
}

@*
    ClubSite-CSS-Links direkt mit absoluten Pfaden.
    Die Layout-Version mit ~/assets/... wird bei RCL-Pages nicht aufgelöst,
    weil ClubSite's _ViewStart.cshtml diese Datei überschreibt und die
    Tag-Helper für ~/ nicht im RCL-Kontext registriert sind.
*@
<link rel="stylesheet" href="/assets/css/bootstrap.min.css">
<link rel="stylesheet" href="/assets/fonts/fonts-lato-raleway.css">
<link rel="stylesheet" href="/assets/css/style.min.css">
<link href="/assets/css/fontawesome/fontawesome.min.css" rel="stylesheet">